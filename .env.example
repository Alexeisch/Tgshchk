# Скопируйте этот файл под именем .env и впишите свой токен от @BotFather
BOT_TOKEN=сюда_вставьте_токен

# Ваш часовой пояс (Europe/Moscow, Europe/Kaliningrad, Asia/Yekaterinburg, Asia/Novosibirsk, Europe/Kyiv, Asia/Almaty ...)
TIMEZONE=Europe/Moscow

# Необязательно: ваш Telegram ID, чтобы ботом не могли пользоваться посторонние.
# Узнать ID можно у бота @userinfobot. Несколько ID — через запятую.
ALLOWED_USERS=
