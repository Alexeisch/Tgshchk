# Служба systemd: запускает бота при включении сервера и перезапускает, если он упал.
# Устанавливается скриптом install.sh, вручную править не нужно.
[Unit]
Description=Telegram task planner bot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/tgbot
ExecStart=/opt/tgbot/.venv/bin/python bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
